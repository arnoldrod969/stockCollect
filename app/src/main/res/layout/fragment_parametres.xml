<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface_variant">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Connexion à Nirgescom" android:textSize="13sp"
            android:textColor="@color/on_surface_variant" android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:hint="Adresse du serveur" android:layout_marginBottom="4dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_url_api"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textUri" android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Exemple : http://192.168.1.10:8000 — sans /api, il est ajouté automatiquement."
            android:textSize="11sp" android:textColor="@color/on_surface_variant"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:hint="Clé d'API" android:layout_marginBottom="12dp"
            app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_cle_api"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPassword" android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:hint="Magasin" android:layout_marginBottom="4dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_magasin"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapCharacters" android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>
        <!--
          Avertissement volontairement explicite : c'est la cause d'erreur la plus probable de tout
          l'écran. L'API compare ce libellé à l'identique avec celui rattaché à la clé et répond 403
          au moindre écart, y compris sur un espace ou une casse.
        -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="⚠ Doit être écrit exactement comme le libellé rattaché à la clé d'API (espaces et majuscules compris), sinon le serveur refuse l'envoi. Ce n'est pas le dépôt saisi pendant la collecte."
            android:textSize="11sp" android:textColor="@color/on_surface_variant"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:hint="Identifiant de la tablette (optionnel)" android:layout_marginBottom="16dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_tablette"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="text" android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_tester"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Tester la connexion" app:cornerRadius="10dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="8dp"/>

        <ProgressBar android:id="@+id/progress_test"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/tv_resultat_test"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_enregistrer"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Enregistrer" app:cornerRadius="10dp"/>
    </LinearLayout>
</ScrollView>
