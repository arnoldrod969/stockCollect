<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface_variant">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal" android:paddingVertical="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Connexion à Nirgescom" android:textSize="13sp"
            android:textColor="@color/on_surface_variant" android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:hint="Adresse du serveur" android:layout_marginBottom="4dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_url_api"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textUri" android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Exemple : http://192.168.1.10:8000 — sans /api, il est ajouté automatiquement."
            android:textSize="12sp" android:textColor="@color/on_surface_variant"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:hint="Clé d'API" android:layout_marginBottom="12dp"
            app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_cle_api"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPassword" android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:hint="Identifiant de la tablette (optionnel)" android:layout_marginBottom="16dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_tablette"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="text" android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_tester"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height" android:insetTop="0dp" android:insetBottom="0dp"
            android:text="Tester la connexion" app:cornerRadius="10dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="8dp"/>

        <ProgressBar android:id="@+id/progress_test"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/tv_resultat_test"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:visibility="gone"
            android:layout_marginBottom="20dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Dépôt" android:textSize="13sp"
            android:textColor="@color/on_surface_variant" android:layout_marginBottom="8dp"/>

        <!--
          La liste vient du serveur et n'est pas saisissable : l'API compare le libellé envoyé à
          celui rattaché à la clé par égalité stricte et répond 403 au moindre écart. Une faute de
          frappe ne se voyait qu'à l'envoi, c'est-à-dire après la clôture, qui est irréversible.
        -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_recuperer_depots"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height" android:insetTop="0dp" android:insetBottom="0dp"
            android:text="Récupérer les dépôts" app:cornerRadius="10dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="8dp"/>

        <ProgressBar android:id="@+id/progress_depots"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/tv_resultat_depots"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <!--
          Champ non saisissable qui ouvre une liste en dialogue, et non un menu déroulant Material :
          l'ExposedDropdownMenu ne s'ouvrait pas sur la tablette de test (aucune fenêtre popup, sans
          la moindre erreur). Le dialogue est par ailleurs le motif de sélection déjà utilisé
          partout ailleurs dans l'app, et lui sait refuser une entrée non sélectionnable.
        -->
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_magasin"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:endIconMode="custom" app:endIconDrawable="@drawable/ic_fleche_bas"
            app:endIconContentDescription="Choisir le dépôt"
            android:hint="Dépôt" android:layout_marginBottom="4dp">
            <!--
              `focusable=true` + `focusableInTouchMode=false` plutôt que `focusable=false` : le
              champ reste inatteignable au doigt (donc pas de clavier, ce que visait l'original),
              mais TalkBack et un clavier physique peuvent de nouveau l'atteindre. Un champ
              purement `focusable=false` était invisible pour le lecteur d'écran alors qu'il porte
              le seul réglage bloquant de l'écran. `inputType=none` suffit à interdire la saisie.
            -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_magasin"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="none"
                android:focusable="true" android:focusableInTouchMode="false"
                android:cursorVisible="false"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="⚠ Choisissez le dépôt rattaché à la clé d'API. Un autre dépôt de la liste reste refusé par le serveur au moment de l'envoi. Les sessions déjà créées gardent le dépôt en vigueur à leur création."
            android:textSize="12sp" android:textColor="@color/on_surface_variant"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_enregistrer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height" android:insetTop="0dp" android:insetBottom="0dp"
            android:text="Enregistrer" app:cornerRadius="10dp"/>
    </LinearLayout>
</ScrollView>
