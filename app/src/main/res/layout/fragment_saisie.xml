<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface_variant">
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_scanner"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:minHeight="@dimen/button_height" android:insetTop="0dp" android:insetBottom="0dp"
        android:text="📷 Scanner un article"
        android:layout_marginHorizontal="@dimen/screen_padding_horizontal" android:layout_marginVertical="12dp"
        app:cornerRadius="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_recherche"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:layout_constraintTop_toBottomOf="@id/btn_scanner"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_recherche"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Rechercher par nom..." android:inputType="text" android:maxLines="1"/>
    </com.google.android.material.textfield.TextInputLayout>
    <!--
      `android:maxHeight` n'a aucun effet sur un RecyclerView : la liste de suggestions pouvait
      donc grandir jusqu'à couvrir la saisie. Le plafond se pose côté ConstraintLayout, avec
      `layout_constrainedHeight` qui laisse la vue rester plus petite que son maximum.
    -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_recherche"
        android:layout_width="0dp" android:layout_height="wrap_content"
        app:layout_constraintHeight_max="240dp" app:layout_constrainedHeight="true"
        android:background="@color/surface" android:visibility="gone"
        android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
        app:layout_constraintTop_toBottomOf="@id/til_recherche"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/tv_nb_lignes" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="0 ligne"
        android:textSize="13sp" android:textColor="@color/on_surface_variant"
        android:layout_marginHorizontal="@dimen/screen_padding_horizontal" android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/rv_recherche"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView android:id="@+id/tv_aucune_ligne" android:layout_width="0dp"
        android:layout_height="wrap_content" android:text="Aucun article saisi.\nScannez ou recherchez un article."
        android:gravity="center" android:visibility="gone" android:textSize="15sp"
        android:textColor="@color/on_surface_variant"
        android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
        app:layout_constraintTop_toBottomOf="@id/tv_nb_lignes" app:layout_constraintBottom_toTopOf="@id/btn_cloturer"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_lignes"
        android:layout_width="0dp" android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
        app:layout_constraintTop_toBottomOf="@id/tv_nb_lignes"
        app:layout_constraintBottom_toTopOf="@id/btn_cloturer"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_cloturer"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:minHeight="@dimen/button_height" android:insetTop="0dp" android:insetBottom="0dp"
        android:text="Clôturer la session"
        android:layout_marginHorizontal="@dimen/screen_padding_horizontal" android:layout_marginVertical="12dp"
        app:cornerRadius="10dp" app:backgroundTint="@color/red_container"
        android:textColor="@color/red_on_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
