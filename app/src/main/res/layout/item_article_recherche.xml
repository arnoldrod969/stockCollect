<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="@dimen/touch_target_min"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingHorizontal="12dp" android:paddingVertical="8dp"
    android:background="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginEnd="8dp">
        <TextView android:id="@+id/tv_nom_produit" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/on_surface"/>
        <TextView android:id="@+id/tv_code_produit" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/on_surface_variant"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_ajouter"
        android:layout_width="@dimen/touch_target_min" android:layout_height="@dimen/touch_target_min"
        android:text="+" android:textSize="20sp"
        android:contentDescription="@string/cd_ajouter_article"
        android:insetTop="0dp" android:insetBottom="0dp"
        android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
        app:cornerRadius="24dp"/>
</LinearLayout>
