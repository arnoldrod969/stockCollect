<?xml version="1.0" encoding="utf-8"?>
<!--
  Contour du champ de quantité des lignes de collecte. Sans lui (background="@null"), le champ
  était indiscernable d'un simple libellé : rien n'indiquait qu'on pouvait taper la quantité au
  clavier plutôt que d'appuyer vingt fois sur « + ».
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="8dp" />
    <solid android:color="@color/white" />
    <stroke android:width="1dp" android:color="@color/outline" />
</shape>
